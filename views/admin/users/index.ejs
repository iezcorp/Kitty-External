<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/nav', { activePage: 'admin' }) %>

  <div class="admin-shell">
    <%- include('../../partials/admin-sidebar', { activeSection: 'users' }) %>

    <main class="admin-main">
      <div class="admin-page-header">
        <h1>Users</h1>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>User</th><th>Discord ID</th><th>Joined</th><th>Last Login</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr><td colspan="6" style="color:var(--text-muted);">No users have logged in yet.</td></tr>
            <% } %>
            <% users.forEach(u => { %>
              <tr data-row-id="<%= u.id %>">
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <img src="<%= u.avatar %>" alt="" style="width:28px;height:28px;border-radius:50%;" />
                    <div>
                      <div><%= u.displayName %></div>
                      <div style="color:var(--text-muted);font-size:12.5px;">@<%= u.username %></div>
                    </div>
                  </div>
                </td>
                <td><%= u.discordId %></td>
                <td><%= new Date(u.createdAt).toLocaleDateString() %></td>
                <td><%= new Date(u.lastLoginAt).toLocaleDateString() %></td>
                <td>
                  <% if (u.disabled) { %>
                    <span class="badge badge-disabled">Disabled</span>
                  <% } else { %>
                    <span class="badge badge-verified">Verified</span>
                  <% } %>
                </td>
                <td>
                  <div class="table-actions">
                    <% if (u.disabled) { %>
                      <button class="btn btn-secondary btn-sm" data-user-action="enable" data-id="<%= u.id %>">Enable</button>
                    <% } else { %>
                      <button class="btn btn-secondary btn-sm" data-user-action="disable" data-id="<%= u.id %>">Disable</button>
                    <% } %>
                    <button class="btn btn-danger btn-sm" data-user-action="delete" data-id="<%= u.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="form-hint" style="margin-top:16px;">Kitty never stores Discord passwords — authentication happens entirely through Discord OAuth2.</p>
    </main>
  </div>

  <%- include('../../partials/toast-container') %>
  <script src="/js/main.js"></script>
  <script src="/js/admin-users.js"></script>
</body>
</html>
