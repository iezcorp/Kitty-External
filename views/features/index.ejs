<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav', { activePage: 'features' }) %>

  <main>
    <section class="section" style="padding-top:80px;">
      <div class="section-header">
        <span class="section-eyebrow">Capabilities</span>
        <h2>Features</h2>
        <p>An early look at what Kitty offers today — this list grows with every release.</p>
      </div>
      <div class="grid">
        <% features.forEach(f => { %>
          <div class="card">
            <div class="card-icon"><%- include('../partials/icon', { name: f.icon }) %></div>
            <h3><%= f.title %></h3>
            <p><%= f.description %></p>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/toast-container') %>
  <script src="/js/main.js"></script>
</body>
</html>
