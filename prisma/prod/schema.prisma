// Kitty — production (Vercel) Prisma schema.
// Vercel's filesystem is ephemeral, so production uses PostgreSQL (e.g. Neon
// or Supabase free tier). The deployed build command runs:
//   prisma generate --schema prisma/prod/schema.prisma
//   prisma migrate deploy --schema prisma/prod/schema.prisma
// Local development keeps using prisma/schema.prisma (SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  discordId     String   @unique
  username      String
  discriminator String?
  displayName   String
  avatar        String?
  verified      Boolean  @default(false)
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastLoginAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([discordId])
}

model Update {
  id               String   @id @default(cuid())
  title            String
  version          String
  robloxVersion    String?
  shortDescription String
  description      String
  changes          String // JSON-encoded string array of change lines
  imageUrl         String?
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  publishedAt      DateTime?

  @@index([published, createdAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  ipAddress String
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // e.g. "admin:Iez" or "user:<discordId>"
  action    String // e.g. "update.publish", "user.disable"
  target    String? // id of the affected resource
  metadata  String? // JSON-encoded extra context
  createdAt DateTime @default(now())

  @@index([actor, createdAt])
}

model File {
  id        String   @id @default(cuid())
  name      String   @unique
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}