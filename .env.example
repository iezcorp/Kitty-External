# Kitty — environment variables
# Copy this file to .env locally. Vercel: add these in Project -> Settings -> Environment Variables.

# Session cookie signing secret (long random string). REQUIRED.
# Generate one, e.g.: [System.Convert]::ToBase64String((1..64 | % { Get-Random -Maximum 256 }))
SESSION_SECRET=replace_with_a_long_random_secret

# Database
# Local (SQLite): file:./dev.db
# Production (Vercel): your PostgreSQL connection string, e.g. Neon or Supabase free tier.
DATABASE_URL="file:./dev.db"
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-app.vercel.app/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Site URL used for links/logging
BASE_URL=https://your-app.vercel.app

# Owner (admin) Discord usernames, comma-separated, without "@". Those accounts
# get automatic admin access when they log in. Default: bloomsaltluvsyou
ADMIN_OWNER_USERNAMES=bloomsaltluvsyou

# Maximum uploaded build size in MB (default 50).
# Note: Vercel free tier caps function request bodies around 4.5MB — larger
# uploads require a paid plan or external storage.
DOWNLOAD_MAX_MB=50